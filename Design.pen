                {
                  "type": "text",
                  "id": "apD4i",
                  "name": "SEO Body 1",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Pasting raw JSON from an API and translating it to TypeScript by hand wastes minutes on every feature. DevUtilityHub converts complex, nested payloads into typed interfaces instantly — preserving union literals, arrays, optional fields and nested object references as distinct interfaces.",
                  "lineHeight": 1.6,
                  "fontFamily": "$sans",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "BwO63",
                  "name": "SEO Body 2",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Everything runs on the client side, so sensitive payloads never leave your machine. There are no accounts, no limits and no watermarks — paste, convert and copy the result straight into your codebase.",
                  "lineHeight": 1.6,
                  "fontFamily": "$sans",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
